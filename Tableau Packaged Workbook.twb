              <flipboard active-id='5' nav-type='caption' show-nav-arrows='true'>
                <story-points>
                  <story-point caption='The world at a glance: average life expectancy is 67.65 years, but median GDP per capita is only 5,900' captured-sheet='Dashboard 1' id='1'>
                    <capturedDeltas>
                      <worksheet name='Map'>
                        <style delta-type='added'>
                          <style-rule element='axis'>
                            <encoding attr='space' class='0' field='[federated.1wt7dck05r5s2l1c8t8xi11wyjcn].[Latitude (generated)]' field-type='quantitative' max='19510687.844262358' min='-8280780.6158260936' projection='EPSG:3857' range-type='fixed' scope='rows' type='space' />
                            <encoding attr='space' class='0' field='[federated.1wt7dck05r5s2l1c8t8xi11wyjcn].[Longitude (generated)]' field-type='quantitative' max='33758706.277192444' min='-33758706.277192444' projection='EPSG:3857' range-type='fixed' scope='cols' type='space' />
                          </style-rule>
                        </style>
                      </worksheet>
                    </capturedDeltas>
                  </story-point>
                  <story-point caption='Wealth drives health: GDP per capita correlates -0.86 with infant mortality and +0.81 with life expectancy' captured-sheet='Dashboard 1' id='2'>
                    <capturedDeltas>
                      <worksheet name='Map'>
                        <style delta-type='added'>
                          <style-rule element='axis'>
                            <encoding attr='space' class='0' field='[federated.1wt7dck05r5s2l1c8t8xi11wyjcn].[Latitude (generated)]' field-type='quantitative' max='19509270.516477145' min='-8254434.9934656415' projection='EPSG:3857' range-type='fixed' scope='rows' type='space' />
                            <encoding attr='space' class='0' field='[federated.1wt7dck05r5s2l1c8t8xi11wyjcn].[Longitude (generated)]' field-type='quantitative' max='33747784.51583147' min='-33702179.909232587' projection='EPSG:3857' range-type='fixed' scope='cols' type='space' />
                          </style-rule>
                        </style>
                      </worksheet>
                      <datasource name='Parameters'>
                        <column name='[Parameter 0835963267944448]' value='&quot;Life expectancy&quot;' />
                      </datasource>
                    </capturedDeltas>
                  </story-point>
                  <story-point caption='Growth doesn’t follow income (correlation ≈ -0.09), and outliers stand out: Zimbabwe at 133% inflation, Iraq at 52.3% growth' captured-sheet='Dashboard 2' id='3'>
                    <capturedDeltas>
                      <datasource name='Parameters'>
                        <column name='[Parameter 0835963270324229]' value='&quot;Zimbabwe&quot;' />
