      <column datatype='real' name='[Birth rate(births/1000 population)]' role='measure' type='quantitative' />
      <column caption='Trade Extreme' datatype='boolean' name='[Calculation_0810125943148544]' role='measure' type='nominal'>
        <calculation class='tableau' formula='RANK_UNIQUE(SUM([Calculation_0835963272744972])) &lt;= 5 OR RANK_UNIQUE(SUM([Calculation_0835963272744972]), &apos;asc&apos;) &lt;= 5'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Trade Position' datatype='string' name='[Calculation_0810125943304193]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([Calculation_0835963272744972]) &gt;= 0 THEN &quot;Surplus&quot; ELSE &quot;Deficit&quot; END' />
      </column>
      <column caption='Income Group' datatype='string' name='[Calculation_0835963271385095]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([GDP - per capita]) THEN &quot;No data&quot;&#13;&#10;ELSEIF [GDP - per capita] &gt;= [Parameters].[Parameter 0835963269218306] THEN &quot;High&quot;&#13;&#10;ELSEIF [GDP - per capita] &gt;= [Parameters].[Parameter 0835963269935107] THEN &quot;Middle&quot;&#13;&#10;ELSE &quot;Low&quot; END' />
      </column>
      <column caption='Selected Metric Value' datatype='real' name='[Calculation_0835963271819272]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 0835963267944448]&#13;&#10;WHEN &quot;GDP per capita&quot; THEN [GDP - per capita]&#13;&#10;WHEN &quot;Life expectancy&quot; THEN [Life expectancy at birth(years)]&#13;&#10;WHEN &quot;Infant mortality&quot; THEN [Infant mortality rate(deaths/1000 live births)]&#13;&#10;WHEN &quot;Birth rate&quot; THEN [Birth rate(births/1000 population)]&#13;&#10;WHEN &quot;Unemployment&quot; THEN [Unemployment rate(%)]&#13;&#10;END' />
      </column>
      <column caption='Top N Flag' datatype='boolean' name='[Calculation_0835963272269833]' role='measure' type='nominal'>
        <calculation class='tableau' formula='RANK_UNIQUE(SUM([Calculation_0835963271819272])) &lt;= [Parameters].[Parameter 0835963268968449]'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Internet Penetration' datatype='real' name='[Calculation_0835963272548362]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Internet users] / [Population]' />
      </column>
      <column caption='Natural Increase' datatype='real' name='[Calculation_0835963272609803]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Birth rate(births/1000 population)] - [Death rate(deaths/1000 population)]' />
      </column>
      <column caption='Trade Balance' datatype='integer' name='[Calculation_0835963272744972]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Exports] - [Imports]' />
      </column>
      <column caption='Inflation Alert' datatype='string' name='[Calculation_0835963272826893]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Inflation rate (consumer prices)(%)] &gt; [Parameters].[Parameter 0835963270160388] THEN &quot;High inflation&quot;&#13;&#10;ELSE &quot;Normal&quot; END' />
      </column>
      <column caption='Selected Country LifeExp' datatype='real' name='[Calculation_0835963273109518]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Country] = [Parameters].[Parameter 0835963270324229] THEN [Life expectancy at birth(years)] END' />
      </column>
      <column caption='Selected Country GDPpc' datatype='integer' name='[Calculation_0835963273302031]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Country] = [Parameters].[Parameter 0835963270324229] THEN [GDP - per capita] END' />
      </column>
      <column caption='Countries Above Alert' datatype='integer' name='[Calculation_1566040045838336]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [Inflation rate (consumer prices)(%)] &gt; [Parameters].[Parameter 0835963270160388] THEN [Country] END)' />
      </column>
      <column datatype='string' name='[Country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
        <semantic-values semantic-role='[Country].[Name]'>
          <semantic-value key='&quot;Congo Republic of the&quot;' value='&quot;Congo&quot;' />
